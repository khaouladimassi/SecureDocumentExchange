<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.securedocumentexchange.controller.RegisterController"
      spacing="15"
      alignment="CENTER"
      prefWidth="500"
      prefHeight="500">

    <padding>
        <Insets top="30"
                right="40"
                bottom="30"
                left="40"/>
    </padding>

    <Label text="👤 Créer un compte utilisateur"
           style="-fx-font-size:26px; -fx-font-weight:bold;"/>

    <Label text="Nom utilisateur"
           style="-fx-font-size:15px;"/>

    <TextField fx:id="usernameField"
               promptText="Exemple : utilisateur1"
               prefWidth="300"/>

    <Label text="Mot de passe"
           style="-fx-font-size:15px;"/>

    <PasswordField fx:id="passwordField"
                   promptText="Minimum 6 caractères"
                   prefWidth="300"/>

    <Label text="Confirmer le mot de passe"
           style="-fx-font-size:15px;"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirmer le mot de passe"
                   prefWidth="300"/>

    <Button text="📝 Créer le compte"
            onAction="#register"
            prefWidth="250"
            prefHeight="40"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           style="-fx-font-size:14px;"/>

    <Button text="← Retour à la connexion"
            onAction="#backToLogin"
            prefWidth="220"/>

</VBox>