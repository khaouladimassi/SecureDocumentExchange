<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.securedocumentexchange.controller.LoginController"
      spacing="15"
      alignment="CENTER"
      prefWidth="500"
      prefHeight="500">

    <padding>
        <Insets top="30"
                right="40"
                bottom="30"
                left="40"/>
    </padding>

    <Label text="🔐 Secure Document Exchange"
           style="-fx-font-size:25px; -fx-font-weight:bold;"/>

    <Label text="Connexion"
           style="-fx-font-size:20px; -fx-font-weight:bold;"/>

    <TextField fx:id="usernameField"
               promptText="Nom utilisateur"
               prefWidth="300"/>

    <PasswordField fx:id="passwordField"
                   promptText="Mot de passe"
                   prefWidth="300"/>

    <Button text="🔐 Se connecter"
            onAction="#login"
            prefWidth="250"
            prefHeight="40"/>

    <Button text="👤 Créer un compte utilisateur"
            onAction="#openRegister"
            prefWidth="250"
            prefHeight="40"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           style="-fx-font-size:14px;"/>

</VBox>